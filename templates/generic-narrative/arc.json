      "ddl": "CREATE TABLE tracking_character_sheet (row_id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, aliases TEXT, biography TEXT, stable_behavior TEXT, voice_and_boundaries TEXT);"
    },
    "content": [
